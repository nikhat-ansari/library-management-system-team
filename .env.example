# Copy this file to .env and replace the MongoDB URI with your Atlas URI. Do not commit secrets.
MONGODB_PORT=27017
API_GATEWAY_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Keep the database path as /lms-users. URL-encode reserved characters in credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/lms-users?retryWrites=true&w=majority
# Auth dashboard reads the same Atlas database unless explicitly overridden.
DASHBOARD_DATABASE=lms-users
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
AI_ENABLED=false
