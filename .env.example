# Copy this file to .env for local Docker Compose use. Do not commit secrets.
MONGODB_PORT=27017
API_GATEWAY_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://mongodb:27017/lms-users
# Optional dashboard override. Include the database name in the URI, or set
# DASHBOARD_DATABASE, so it points at the existing library collections.
# DASHBOARD_MONGODB_URI=mongodb://mongodb:27017/lms-users
# DASHBOARD_DATABASE=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
AI_ENABLED=false
